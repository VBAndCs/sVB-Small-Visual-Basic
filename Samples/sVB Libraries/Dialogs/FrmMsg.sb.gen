'@Form Hints:
'#FrmMsg{
'    BtnYes: Button
'    LblMsg: Label
'    BtnNo: Button
'    BtnCancel: Button
'}

Me = "frmmsg"
BtnYes = "frmmsg.btnyes"
LblMsg = "frmmsg.lblmsg"
BtnNo = "frmmsg.btnno"
BtnCancel = "frmmsg.btncancel"
_path = Program.Directory + "\frmmsg.xaml"
FrmMsg = Forms.LoadForm("FrmMsg", _path)
Form.SetArgsArr(frmmsg, Stack.PopValue("_frmmsg_argsArr"))
'#Events{
'    BtnYes: OnClick
'    BtnNo: OnClick
'    BtnCancel: OnClick
'    FrmMsg: OnPreviewKeyDown
'}

' BtnYes Events:
Control.HandleEvents(BtnYes)
Control.OnClick = BtnYes_OnClick

' BtnNo Events:
Control.HandleEvents(BtnNo)
Control.OnClick = BtnNo_OnClick

' BtnCancel Events:
Control.HandleEvents(BtnCancel)
Control.OnClick = BtnCancel_OnClick

' FrmMsg Events:
Control.HandleEvents(FrmMsg)
Form.OnPreviewKeyDown = Form_OnPreviewKeyDown


Form.Show(Me)
