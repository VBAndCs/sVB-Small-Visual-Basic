      LettersMap["th"] = "ذ"
      LettersMap["ie"] = "ي"
      LettersMap["ei"] = "ي"
      LettersMap["ea"] = "ي"
      LettersMap["ou"] = "و"
      LettersMap["ow"] = "و"
      
      LettersMap["a"] = "ا"
      LettersMap["b"] = "ب"
      LettersMap["c"] = "ك"
      LettersMap["d"] = "د"
      LettersMap["e"] = "ي"
