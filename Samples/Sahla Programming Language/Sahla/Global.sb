      LettersMap["l"] = "ل"
      LettersMap["m"] = "م"
      LettersMap["n"] = "ن"
      LettersMap["o"] = "و"
      LettersMap["p"] = "ب"
      LettersMap["q"] = "ق"
      LettersMap["r"] = "ر"
      LettersMap["s"] = "س"
      LettersMap["t"] = "ت"
