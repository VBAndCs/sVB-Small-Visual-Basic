_EnLine1 = "Line"
_EnLine2 = "Line2"
_EnRead = "Read"
_EnText1 = "Text"
_EnText2 = "Text2"
_EnNumber = "Number"
_EnMove = "Move"
_EnTurn = "Turn"
_EnSpeed = "Speed"
_EnTurtle = "Turtle"
_EnRandom = "Random"
_EnWait = "Wait"
_EnSound = "Play"
_EnBeep = "Beep"
_EnBell = "Bell"
_EnDing = "Ding"
_EnClick = "Click"
_EnChime = "Chime"

_EnCatSound = "Meow"
_EnCrowSound = "Caw"
_EnCowSound = "Moo"
_EnDogSound = "Bark"
_EnDonkeySound = "Bray"
_EnDuckSound = "Quack"
_EnElephantSound = "Trumpet"
_EnHorseSound = "Neigh"
_EnLionSound = "Roar"
_EnRoosterSound = "Crowing"
_EnSheepSound = "Baa"
_EnWolfSound = "Howl"

_EnImage = "Show"
_EnImageSize = "Size"
_EnOrangeName = "Orange"
_EnBananaName = "Banana"
_EnAppleName = "Apple"
_EnPlumName = "Plum"
_EnFigName = "Fig"
_EnCatName = "Cat"
_EnCrowName = "Crow"
_EnCowName = "Cow"
_EnDogName = "Dog"
_EnDonkeyName = "Donkey"
_EnDuckName = "Duck"
_EnElephantName = "Elephant"
_EnHorseName = "Horse"
_EnLionName = "Lion"
_EnRoosterName = "Rooster"
_EnSheepName = "Sheep"
_EnWolfName = "Wolf"

_EnIntegralDivision = "\"
_EnCommentSymbol = "'"

OrgTokes = {}
DestTokes = {}

EnBasicWords = {
   _EnTrue, _EnFalse, _EnIf, _EnElse, _EnElseIf, _EnEndIf, _EnAnd, _EnOr,
   _EnWhile, _EnWend, _EnFor, _EnTo1, _EnTo2, _EnStep, _EnNext, _EnExitLoop,
   _EnWrite, _EnLine1, _EnLine2,
   _EnRead, _EnText1, _EnText2, _EnNumber,
   _EnMove, _EnTurn, _EnSpeed, _EnTurtle,
   _EnWait, _EnRandom,
   _EnSound,
   _EnBeep, _EnBell, _EnDing, _EnClick, _EnChime,
   _EnDuckSound, _EnSheepSound, _EnCowSound, _EnLionSound, _EnHorseSound, _EnRoosterSound, _EnWolfSound, _EnCatSound, _EnDogSound, _EnCrowSound, _EnDonkeySound, _EnElephantSound,
   _EnImage,
   _EnOrangeName, _EnBananaName, _EnAppleName, _EnPlumName, _EnFigName,
   _EnCatName, _EnCrowName, _EnCowName, _EnDogName, _EnDonkeyName, _EnDuckName, _EnElephantName, _EnHorseName, _EnLionName, _EnRoosterName, _EnSheepName, _EnWolfName
}

Sub InitTransTokes(forwardConversion)
   count = EnBasicWords.Count
   If forwardConversion Then
      For i = 1 To count
         enTok = EnBasicWords[i]
         OrgTokes[enTok] = BasicWords[i]
         DestTokes[enTok] = enTok
      Next
      
      OrgTokes[_EnImageSize] = _ImageSize
      DestTokes[_EnImageSize] = _EnImageSize
      
      OrgTokes[_EnIntegralDivision] = _IntegralDivision
      DestTokes[_EnIntegralDivision] = _EnIntegralDivision
      
      OrgTokes[_EnCommentSymbol] = _CommentSymbol
      DestTokes[_EnCommentSymbol] = _EnCommentSymbol
      
   Else
      ' Reverse conversion: English → native.
      For i = 1 To count
         enTok = EnBasicWords[i]
         OrgTokes[enTok] = enTok
         DestTokes[enTok] = BasicWords[i]
      Next
      
      OrgTokes[_EnTo2] = _EnTo1
      OrgTokes[_EnLine2] = _EnLine1
      DestTokes[_EnLine1] = _Line2
      OrgTokes[_EnText2] = _EnText1
      
      OrgTokes[_EnImageSize] = _EnImageSize
      DestTokes[_EnImageSize] = _ImageSize
      
      OrgTokes[_EnIntegralDivision] = _EnIntegralDivision
      DestTokes[_EnIntegralDivision] = _IntegralDivision
      
      OrgTokes[_EnCommentSymbol] = _EnCommentSymbol
      DestTokes[_EnCommentSymbol] = _CommentSymbol
   EndIf
EndSub

Function ConvertToNativeSahlaCode(enCode)
   Return _ConvertSahlaCode(enCode, True, False)
EndFunction

Function ConvertSahlaCode(toEnSahla)
   code = Text.Replace(EditorTextBox.Text, Chars.CrLf, Chars.Lf)
   Return _ConvertSahlaCode(code, toEnSahla, True)
EndFunction

ImageCommandLine = 0
SizeAssignmentLine = 0

Function _ConvertSahlaCode(code, toEnSahla, forwardConversion)
   ImageCommandLine = 0
   SizeAssignmentLine = 0
   ConvertToEnSahla = toEnSahla
   InitTransTokes(forwardConversion)
   MapLetters(forwardConversion)
   
   Vars = {}
   Statements = Text.Split(code, Chars.Lf, False, False)
   LineIndex = 1
   sVBLines = {}
   
   ForEach statement In Statements
      indentLength = 0
      ForEach c In statement
         If c = " " Then
            indentLength = indentLength + 1
         Else
            ExitLoop
         EndIf
      Next
      
      Tokenize(statement, LineIndex, OrgTokes[_EnCommentSymbol])
      sVBLines.Append(Text.Repeat(" ", indentLength) & ConvertLine())
      LineIndex = LineIndex + 1
   Next
   
   If ConvertToEnSahla = False And ImageCommandLine > 0 And (SizeAssignmentLine = 0 Or SizeAssignmentLine > ImageCommandLine) Then
      setsize = _EnImageSize & " = 100"
      Return setsize & Text.NewLine & sVBLines.Join(Chars.CrLf)
   Else
      Return sVBLines.Join(Chars.CrLf)
   EndIf
EndFunction

