Sub MnuRun_OnClick()
   UndoMonitor.Pause()
   AddUndoPoint(True)
   FormatCode()
   IsRunning = True
   ChangeState()
   LblNew.Enabled = False
   LblOpen.Enabled = False
   LblSave.Enabled = False
   LblCopy.Enabled = False
   LblCut.Enabled = False
   LblUndo.Enabled = False
   LblRedo.Enabled = False
   TW.Title = "Text Window"
   Global.Run()
   IsRunning = False
   GWTimer.Resume()
EndSub

Sub MnuStop_OnClick()
   GW.Close()
   TW.Close()
   IsRunning = False
EndSub

Function GetPath(filePath)
   If UseParentFolder Then
      Return "../" & filePath
   Else
      Return filePath
   EndIf
EndFunction

