TxtEditor.Focus()
Global.StartColoringTimer()
TxtEditor.CaretIndex = TxtEditor.Length
TxtEditor.CaretIndex = 0

Sub UndoMonitor_OnTick()
   UndoMonitor.Pause()
   AddUndoPoint(True)
   UndoMonitor.Resume()
EndSub

Sub ResetUndo()
   UndoMonitor.Pause()
   Stack.Clear("undo")
   Stack.Clear("redo")
   TxtEditor.CaretIndex = TxtEditor.Length
   TxtEditor.CaretIndex = 1
   JustFormatting = False
   AddUndoPoint(False)
EndSub


Sub TxtEditor_OnGotFocus()
   UndoMonitor.Resume()
EndSub

Sub TxtEditor_OnLostFocus()
   AddUndoPoint(True)
   UndoMonitor.Pause()
EndSub

Sub ReportUndoChanges()
   UndoMonitor.Pause()
   key = Keyboard.LastKey
   If TxtEditor.SelectionLength > 0 Then
      AddUndoPoint(True)
   ElseIf Keyboard.CtrlPressed And key = Keys.V Then
      AddUndoPoint(True)
   ElseIf key <> LastKey Then
      If key = Keys.Space Or key = Keys.Enter Or key = Keys.Delete Or key = Keys.Back Then
         AddUndoPoint(True)
      EndIf
   EndIf
   
   LastKey = key
   UndoMonitor.Resume()
EndSub

Sub AddUndoPoint(updateSelection)
   UndoMonitor.Pause()
   If JustFormatting Then
      JustFormatting = False
      currentText = LastTextB4Format
   Else
      currentText = TxtEditor.Text
   EndIf
   
   lastState = Stack.PeekValue("undo")
   If lastState = "" Or currentText <> lastState[1] Then
      Stack.PushValue("undo", {currentText, TxtEditor.SelectionStart, TxtEditor.SelectionLength})
      Stack.Clear("redo")
   ElseIf updateSelection And (TxtEditor.SelectionStart <> lastState[2] Or TxtEditor.SelectionLength <> lastState[3]) Then
      Stack.PopValue("undo")
      Stack.PushValue("undo", {currentText, TxtEditor.SelectionStart, TxtEditor.SelectionLength})
   EndIf
   
   UndoMonitor.Resume()
EndSub

Sub Undo()
   AddUndoPoint(False)
   If Stack.GetCount("undo") > 1 Then
      Stack.PushValue("redo", Stack.PopValue("undo"))
      prevState = Stack.PeekValue("undo")
      TxtEditor.Text = prevState[1]
      TxtEditor.SelectionStart = prevState[2]
      TxtEditor.SelectionLength = prevState[3]
      LastLineIndex = LastLineIndex - 1
   EndIf
EndSub

Sub Redo()
   AddUndoPoint(False)
   If Stack.GetCount("redo") > 0 Then
      nextState = Stack.PopValue("redo")
      Stack.PushValue("undo", nextState)
      TxtEditor.Text = nextState[1]
      TxtEditor.SelectionStart = nextState[2]
      TxtEditor.SelectionLength = nextState[3]
      LastLineIndex = LastLineIndex - 1
   EndIf
EndSub

Sub StopProgram()
   If IsRunning = False And GW.IsClosed Then
      GWTimer.Pause()
      Sound.Stop("")
      ChangeState()
      Me.Focus()
      TxtEditor.Focus()
      MnuFile_OnOpen()
      MnuEdit_OnOpen()
      LblOpen.Enabled = True
   EndIf
EndSub

Sub ChangeState()
   state = (IsRunning = False)
   MnuFile.Enabled = state
   MnuEdit.Enabled = state
   MnuView.Enabled = state
   MnuRun.Enabled = state
   LblRun.Visible = state
   LblStop.Visible = IsRunning
   MnuStop.Enabled = IsRunning
   TxtEditor.ReadOnly = IsRunning
EndSub

