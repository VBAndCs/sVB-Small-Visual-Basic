   hasSelection = TxtEditor.SelectionLength > 0 And notRunning
   
   MnuCopy.Enabled = hasSelection
   LblCopy.Enabled = hasSelection
   
   MnuCut.Enabled = hasSelection
   LblCut.Enabled = hasSelection
   
   MnuPaste.Enabled = notRunning
   LblPaste.Enabled = notRunning
   MnuAddSoundPath.Enabled = notRunning
   
   MnuDelete.Enabled = hasSelection
