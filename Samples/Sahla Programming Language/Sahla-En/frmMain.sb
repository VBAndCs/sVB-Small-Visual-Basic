Sub Form_OnPreviewKeyDown()
   If Keyboard.CtrlPressed Then
      key = Event.LastKey
      size = 0
      If key = Keys.OemPlus Then
         size = TxtEditor.FontSize + 1
         Event.Handled = True
      ElseIf key = Keys.OemMinus Then
         size = TxtEditor.FontSize - 1
         Event.Handled = True
      EndIf
      ChangeFontSize(size)
   EndIf
EndSub


Sub TxtEditor_OnMouseWheel()
   If Keyboard.CtrlPressed Then
      Event.Handled = True
      size = TxtEditor.FontSize + Event.LastMouseWheelDirection
      ChangeFontSize(size)
   EndIf
EndSub

Sub ChangeFontSize(size)
   If size < 50 And size > 10 Then
      oldLineHeight = LblLine.Height
      oldScroll = TxtEditor.VerticalScrollOffset
      If oldLineHeight > 0 Then
         scrollRatio = oldScroll / oldLineHeight
      Else
         scrollRatio = 0
      EndIf
      TxtEditor.FontSize = size
      LblFormat.FontSize = size
      LblLine.FontSize = size
      LblBackground.FontSize = size
      TW.FontSize = TxtEditor.FontSize
      TxtEditor.VerticalScrollOffset = scrollRatio * LblLine.Height
   EndIf
EndSub

Sub LblMargin_OnMouseWheel()
   direction = Event.LastMouseWheelDirection
   lineHeight = LblLine.Height
   If Keyboard.CtrlPressed Then
      size = TxtEditor.FontSize + Event.LastMouseWheelDirection
      ChangeFontSize(size)
   ElseIf direction > 0 Then
      TxtEditor.VerticalScrollOffset = TxtEditor.VerticalScrollOffset - lineHeight
   Else
      TxtEditor.VerticalScrollOffset = TxtEditor.VerticalScrollOffset + lineHeight
   EndIf
EndSub
