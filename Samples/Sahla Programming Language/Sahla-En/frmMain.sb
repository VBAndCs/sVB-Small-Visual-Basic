Sub OnScroll()
   If ExitTextChanged Or ExitSelection Then
      Return
   EndIf
   
   AdjustLabels()
   TxtEditor_OnSelection()
EndSub

Sub AdjustLabels()
   horizontalScrollOffset = TxtEditor.HorizontalScrollOffset
   LblFormat.Width = TxtEditor.Width + 2 * horizontalScrollOffset
   
   v = TxtEditor.VerticalScrollOffset
   LblFormat.Height = TxtEditor.Height + v
   LblFormat.Top = -v
   
   w = TxtEditor.Width + 2 * horizontalScrollOffset
   LblLine.Width = w - 20
   LblBackground.Width = w - 20
   
   If RightToLeft Then
      x = TxtEditor.Left - horizontalScrollOffset - 3
      x1 = x - TxtEditor.Padding
   Else
      x = TxtEditor.Left - horizontalScrollOffset + 3
      x1 = x + TxtEditor.Padding
   EndIf
   
   LblFormat.Left = x
   LblLine.Left = x1 - 5
   LblBackground.Left = x1 - 5
   
   top = TxtEditor.CaretTop
   LblLine.Top = top - 1
   LblBackground.Top = top - 1
   LblNum.Top = top + (LblLine.Height - LblNum.Height) / 2
   
   ShowLineBumbersTimer.Pause()
   ShowLineBumbersTimer.Resume()
EndSub

Sub ShowLineNumbers()
   ShowLineBumbersTimer.Pause()
   If ExitShowLineNumbers Then
      Return
   EndIf
   
   ExitShowLineNumbers = True
   
   marginTop = LblMargin.Top
   marginBottom = LblMargin.Bottom
   lineHeight = LblLine.Height - 2
   offset = TxtEditor.VerticalScrollOffset Mod lineHeight
   top = TxtEditor.Padding - offset + (lineHeight - LblNum.Height) / 2
   n = Math.Truncate(TxtEditor.VerticalScrollOffset / lineHeight) + 1
   left = LblNum.Left
   width = LblNum.Width
   height = LblNum.Height
   arrayIndex = 1
   currentLine = LblNum.Text
   
   For number = n To TxtEditor.LineCount
      If number <> currentLine Then
         lineNumLabel = LineLabels[arrayIndex]
         If lineNumLabel = "" Then
            lineNumLabel = Me.AddLabel(
               "lineNumLabel" & arrayIndex,
               left, top,
               width, height)
            LineLabels[arrayIndex] = lineNumLabel
            lineNumLabel.Text = number
            lineNumLabel.OnMouseLeftDown = Margin_OnMouseLeftDown
            lineNumLabel.OnMouseMove = Margin_OnMouseMove
            lineNumLabel.OnMouseWheel = LblMargin_OnMouseWheel
            lineNumLabel.SetStyle("LabelStyles.style", "NormalNumber")
            lineNumLabel.WordWrap = False
         Else
            lineNumLabel.Visible = True
            lineNumLabel.Left = left
            lineNumLabel.Top = top
            lineNumLabel.Text = number
         EndIf
         lineNumLabel.BringToFront()
         arrayIndex = arrayIndex + 1
      EndIf
      
      top = top + lineHeight
      If top > marginBottom Then
         ExitLoop
      EndIf
   Next
   
   For i = arrayIndex To LineLabels.Count
      lineNumLabel = LineLabels[i]
      lineNumLabel.Visible = False
   Next
   
   LblNum.BringToFront()
   ExitShowLineNumbers = False
EndSub

Sub FrmMain_OnClosing()
   If IsRunning = False Then
      Event.Handled = (AskToSave() = False)
   Else
      GW.Close()
      TW.Close()
      IsRunning = False
      Event.Handled = True
   EndIf
EndSub

Sub MnuNew_OnClick()
   If AskToSave() Then
      TxtEditor.Text = ""
      IsModified = False
      SavedFile = ""
      SetProperties(Global.Ops)
      ResetUndo()
      LblNew.Enabled = False
      LblSave.Enabled = False
   EndIf
   
   Me.Focus()
   TxtEditor.Focus()
EndSub

Sub MnuOpen_OnClick()
   If AskToSave() Then
      If SahlaFilesExtension = "shlen" Then
         filters = {"Sahla code files", SahlaFilesExtension}
      Else
         filters = {
            {"Sahla code files", SahlaFilesExtension},
            {"English Sahla code files", "shlen"}
         }
      EndIf
      fileName = File.OpenFileDialog(filters)
      If fileName <> "" Then
         Open(fileName)
         LblNew.Enabled = True
         LblSave.Enabled = False
      EndIf
   EndIf
   
   Me.Focus()
   TxtEditor.Focus()
EndSub

Sub Open(fileName)
   lines = File.ReadLines(fileName)
   If lines.Count > 0 Then
      Ops!FontName = lines[1]
      Ops!FontSize = lines[2]
      Ops!Bold = lines[3]
      Ops!Italic = lines[4]
      Ops!Underlined = lines[5]
      Ops!ForeColor = lines[6]
      Ops!BackColor = lines[7]
      Ops!RightToLeft = lines[8]
      Ops!MultiLine = lines[9]
      Ops!WordWrap = lines[10]
      SetProperties(Ops)
   EndIf
   
   txt = ""
   For i = 11 To lines.Count - 1
      txt = txt & lines[i] & Text.NewLine
   Next
   
   code = txt & lines[i]
   
   If SahlaFilesExtension.ToLower() <> "shlen" And
         Text.EndsWith(Text.ToLower(fileName), ".shlen") Then
      TxtEditor.Text = Global.ConvertToNativeSahlaCode(code)
      IsModified = True
      SavedFile = ""
   Else
      TxtEditor.Text = code
      SavedFile = fileName
      IsModified = False
   EndIf
   
   ResetUndo()
   TxtEditor.Focus()
EndSub

Sub MnuSave_OnClick()
   FormatCode()
   Save(SavedFile)
EndSub

Sub MnuSaveAs_OnClick()
   FormatCode()
   SaveAs()
EndSub

Function AskToSave()
   FormatCode()
   If IsModified Then
      result = Global.ShowSaveMsg()
      If result = DialogResults.Yes Then
         If Save(SavedFile) = False Then
            Return False
         EndIf
      ElseIf result = DialogResults.Cancel Then
         Return False
      EndIf
   EndIf
   
   Return True
EndFunction


Function Save(fileName)
   If fileName = "" Then
      Return SaveAs()
   ElseIf Text.EndsWith(Text.ToLower(fileName), ".sb") Then
      sVBCode = Global.ConvertSahlaCode(False)
      If File.WriteContents(fileName, sVBCode) = False Then
         Me.ShowMessage(File.LastError, "Error")
         Return False
      EndIf
   Else
      Ops = {}
      Ops!FontName = TxtEditor.FontName
      Ops!FontSize = TxtEditor.FontSize
      Ops!Bold = TxtEditor.FontBold
      Ops!Italic = TxtEditor.FontItalic
      Ops!Underlined = TxtEditor.Underlined
      Ops!ForeColor = LblFormat.ForeColor
      Ops!BackColor = LblFormat.BackColor
      Ops!RightToLeft = TxtEditor.RightToLeft
      Ops!MultiLine = TxtEditor.MultiLine
      Ops!WordWrap = TxtEditor.WordWrap
      If Text.EndsWith(Text.ToLower(fileName), ".shlen")
            And SahlaFilesExtension <> ".shlen" Then
         Ops!Text = Global.ConvertSahlaCode(True)
      Else
         Ops!Text = TxtEditor.Text
      EndIf
      
      If File.WriteContents(fileName, Ops) = False Then
         Me.ShowMessage(File.LastError, "Error")
         Return False
      EndIf
      IsModified = False
   EndIf
   
   LblNew.Enabled = True
   LblSave.Enabled = False
   Return True
EndFunction

FileNumber = 1
Function SaveAs()
   If SavedFile = "" Then
      suggestedName = "App" & FileNumber & "." & SahlaFilesExtension
   Else
      suggestedName = SavedFile
   EndIf
   
   If SahlaFilesExtension = "shlen" Then
      filters = {
         {"Sahla code files", SahlaFilesExtension},
         {"Small Basic code files", "sb"}
      }
   Else
      filters = {
         {"Sahla code files", SahlaFilesExtension},
         {"English Sahla code files", "shlen"},
         {"Small Basic code files", "sb"}
      }
   EndIf
   
   fileName = File.SaveFileDialog(suggestedName, filters)
   
   If fileName = "" Then
      FormatCode()
      Return False
   Else
      If suggestedName.ToLower() <> fileName.ToLower() Then
         FileNumber = FileNumber + 1
      EndIf
      
      If Text.EndsWith(fileName.ToLower(),
            "." & SahlaFilesExtension.ToLower()) Then
         SavedFile = fileName
      EndIf
      
      Return Save(fileName)
   EndIf
EndFunction

