<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== -->
    <!-- Tollbar labels Style -->
    <!-- ===================================================== -->
    <Style x:Key="ToolbarLabelStyle" TargetType="Label">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border x:Name="border"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Image x:Name="img" Source="{TemplateBinding Content}"
                               Width="24"
                               Height="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Mouse-over effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#88FFFFFF"/>
                        </Trigger>
                        
                        <!-- (IsEnabled = False) -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="No"/>
                            <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="img" Property="Opacity" Value="0.4"/>
                        </Trigger>

                        <!-- Click effect -->
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#77FFFFFF" Duration="0:0:0.05"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#44FFFFFF" Duration="0:0:0.05"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== -->
    <!-- 1. Main Menu Style -->
    <!-- ===================================================== -->
    <Style x:Key="MainMenuStyle" TargetType="Menu">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFF176" Offset="0"/>
                    <GradientStop Color="#FF81D4FA" Offset="0.5"/>
                    <GradientStop Color="#FFA5D6A7" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="26"
                            BorderBrush="#FFFFFFFF"
                            BorderThickness="3"
                            Padding="8"
                            Margin="4,2,4,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#50000000"/>
                        </Border.Effect>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>    
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0">
                                <Image Source="/s.ico" Width="28" Height="28" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </StackPanel>

                            <ItemsPresenter Grid.Column="1" VerticalAlignment="Center"/>

                            <!-- Toolbar -->
                            <Border Grid.Column="2" 
                                    Background="#22FFFFFF" 
                                    BorderBrush="#88FFFFFF" 
                                    BorderThickness="1.5" 
                                    CornerRadius="8" 
                                    Padding="2" 
                                    Margin="20,0" 
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0">

                                    <Label x:Name="LblNew" IsEnabled="False" Style="{StaticResource ToolbarLabelStyle}" Tag="New (Ctrl+N)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/new.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Label x:Name="LblOpen" Style="{StaticResource ToolbarLabelStyle}" Tag="Open (Ctrl+O)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/open.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Label x:Name="LblSave" IsEnabled="False" Style="{StaticResource ToolbarLabelStyle}" Tag="Save (Ctrl+S)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/save.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Rectangle Width="2" Height="24" Fill="#88FFFFFF" Margin="4,0" VerticalAlignment="Center"/>

                                    <Label x:Name="LblCopy" IsEnabled="False" Style="{StaticResource ToolbarLabelStyle}" Tag="Copy (Ctrl+C)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/copy.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Label x:Name="LblCut" IsEnabled="False" Style="{StaticResource ToolbarLabelStyle}" Tag="Cut (Ctrl+X)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/cut.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Label x:Name="LblPaste" Style="{StaticResource ToolbarLabelStyle}" Tag="Paste (Ctrl+V)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/paste.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Rectangle Width="2" Height="24" Fill="#88FFFFFF" Margin="4,0" VerticalAlignment="Center"/>

                                    <Label x:Name="LblUndo" IsEnabled="False" Style="{StaticResource ToolbarLabelStyle}" Tag="Undo (Ctrl+Z)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/undo.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Label x:Name="LblRedo" IsEnabled="False" Style="{StaticResource ToolbarLabelStyle}" Tag="Redo (Ctrl+Y)">
                                        <Label.Content>
                                            <BitmapImage UriSource="/../Toolbar/redo.png"/>
                                        </Label.Content>
                                    </Label>

                                    <Rectangle Width="2" Height="24" Fill="#88FFFFFF" Margin="4,0" VerticalAlignment="Center"/>
                                    <Grid>
                                        <Label x:Name="LblRun" Style="{StaticResource ToolbarLabelStyle}" Tag="Run (F5)">
                                            <Label.Content>
                                                <BitmapImage UriSource="/../Toolbar/run.png"/>
                                            </Label.Content>
                                        </Label>

                                        <Label x:Name="LblStop" Style="{StaticResource ToolbarLabelStyle}" Tag="Stop (F6)" Visibility="Collapsed">
                                            <Label.Content>
                                                <BitmapImage UriSource="/../Toolbar/stop.png"/>
                                            </Label.Content>
                                        </Label>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,0">
                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White" FlowDirection="LeftToRight" Margin="10,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Black" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Button x:Name="BtnMinimize" Width="30" Height="30" Margin="3,0" Cursor="Hand" ToolTip="Minimize">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#33FFFFFF" CornerRadius="15" BorderThickness="0" SnapsToDevicePixels="True">
                                                <TextBlock Text="🗕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FF334155" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF94A3B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnClose" Width="30" Height="30" Margin="3,0" Cursor="Hand" ToolTip="Close">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="#33FFFFFF" CornerRadius="15" BorderThickness="0" SnapsToDevicePixels="True">
                                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FF334155" FontWeight="Bold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFE11D48"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== -->
    <!-- 2. Main Menu Item Style -->
    <!-- ===================================================== -->
    <Style x:Key="MainMenuItemStyle" TargetType="MenuItem">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="templateBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        
                        <Grid>
                            <ContentPresenter x:Name="HeaderHost"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom"
                                   VerticalOffset="10"
                                   HorizontalOffset="0"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#FFF8FAFC"
                                        BorderBrush="#FF38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#330284C7" BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" 
                                                FlowDirection="LeftToRight" 
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="templateBorder" Property="Background" Value="#FFE1F5FE"/>
                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="#FF0284C7"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="templateBorder" Property="Background" Value="#FFB3E5FC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== -->
    <!-- 3. Menu Item Style -->
    <!-- ===================================================== -->
    <Style x:Key="MenuItemStyle" TargetType="MenuItem">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#FF0F172A"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Margin" Value="4,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="templateBorder"
                            Background="#FFFFFFFF"
                            BorderBrush="#FFBAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            SnapsToDevicePixels="True"
                            Padding="{TemplateBinding Padding}">

                        <Border.Effect>
                            <DropShadowEffect Color="#15000000" BlurRadius="4" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>

                        <Grid x:Name="ParentGrid" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <!-- Column 0: Icon placeholder with SharedSizeGroup to maintain consistent alignment -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                <!-- Column 1: Fixed-width slot for checkmark to keep all text titles aligned at the exact same horizontal position -->
                                <ColumnDefinition Width="24" SharedSizeGroup="MenuItemCheckColumnGroup"/>
                                <!-- Column 2: Main title text spanning all available space, left-aligned -->
                                <ColumnDefinition Width="*"/>
                                <!-- Column 3: Keyboard shortcut gesture text -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                                <!-- Column 4: Submenu arrow indicator -->
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemPopupColumnGroup"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkmark for checked menu items centered within its dedicated column slot -->
                            <TextBlock x:Name="CheckMark" Grid.Column="1" Text="✔" Foreground="#FF0284C7" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

                            <!-- Main Header Content Presenter aligned strictly to the Left -->
                            <ContentPresenter x:Name="headerContentPresenter" 
                                            Grid.Column="2"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                            <!-- Keyboard Shortcut Gesture Text -->
                            <TextBlock x:Name="GestureText"
                                       Grid.Column="3"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="#FF64748B"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="16,0,8,0"
                                       SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                            <!-- Submenu Arrow Indicator -->
                            <Path x:Name="Arrow" Grid.Column="4" Data="M 0,0 L 4,4 L 0,8 Z" Fill="#FF0284C7" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                            <!-- Submenu Popup Container -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" 
                                   Placement="Right"
                                   PlacementTarget="{Binding ElementName=Arrow}"
                                   Focusable="False"
                                   HorizontalOffset="14"
                                   PopupAnimation="Slide">
                                <Border x:Name="SubMenuBorder"
                                        Background="#FFF8FAFC"
                                        BorderBrush="#FF38BDF8"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#330284C7" BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" FlowDirection="LeftToRight" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Mouse Over Trigger -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="templateBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF38BDF8" Offset="0"/>
                                        <GradientStop Color="#FF0284C7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="#FF0284C7"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                            <Setter TargetName="CheckMark" Property="Foreground" Value="White"/>
                            <Setter TargetName="GestureText" Property="Foreground" Value="#FFE2E8F0"/>
                        </Trigger>

                        <!-- Submenu Open Trigger -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="templateBorder" Property="Background" Value="#FF0284C7"/>
                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="#FF0369A1"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                            <Setter TargetName="GestureText" Property="Foreground" Value="#FFE2E8F0"/>
                        </Trigger>

                        <!-- Is Checked Trigger -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="templateBorder" Property="Background" Value="#FFE0E7FF"/>
                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="#FF3B82F6"/>
                            <Setter Property="Foreground" Value="#FF1E3A8A"/>
                        </Trigger>

                        <!-- Has Items Trigger -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Is Enabled Trigger -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF94A3B8"/>
                            <Setter TargetName="templateBorder" Property="Background" Value="#FFF1F5F9"/>
                            <Setter TargetName="templateBorder" Property="BorderBrush" Value="#FFE2E8F0"/>
                            <Setter TargetName="templateBorder" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== -->
    <!-- 4. Sub Menu Item Style -->
    <!-- ===================================================== -->
    <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="Foreground" Value="#FF263238"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid FlowDirection="LeftToRight">
                        <Border x:Name="ItemBorder"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <DockPanel FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                <ContentPresenter Margin="10,4"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Left"/>
                            </DockPanel>
                        </Border>                        
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#FFE1F5FE"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#FFB3E5FC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FFBDBDBD"/>
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== -->
    <!-- 5. Separator Style -->
    <!-- ===================================================== -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Height="6" Margin="0,4" HorizontalAlignment="Stretch">
                        <Line X1="0" Y1="3" 
                              X2="1" Y2="3"
                              Stretch="Fill"
                              Stroke="#FFE2E8F0" 
                              StrokeThickness="2" 
                              SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource MainMenuStyle}">
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}">
    </Style>
</ResourceDictionary>