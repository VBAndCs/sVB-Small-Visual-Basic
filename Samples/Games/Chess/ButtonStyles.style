<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Base style for shared control properties -->
    <Style x:Key="BaseButtonStyle" TargetType="Control">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="Width" Value="110"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <!-- Shared control template based on ButtonBase to avoid code duplication -->
    <ControlTemplate x:Key="SharedButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="grid">
            <!-- Default state: Gold border with thickness 1 and standard Green gradient background -->
            <Border x:Name="border" CornerRadius="12" BorderBrush="Gold" BorderThickness="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Green" Offset="0"/>
                        <GradientStop Color="LightGreen" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextBlock.Foreground="{TemplateBinding Foreground}">
                </ContentPresenter>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- ToggleButton Checked state: Gold border with thickness 3 -->
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" TargetName="border" Value="#FFFFD700"/>
                <Setter Property="BorderThickness" TargetName="border" Value="3"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" TargetName="border">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF1B4D3E" Offset="0"/>
                            <GradientStop Color="#FF2E8B57" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            
            <!-- MouseOver state: Gold border with thickness 2 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="border" Value="#FFFFD700"/>
                <Setter Property="BorderThickness" TargetName="border" Value="2.5"/>
            </Trigger>
            
            <!-- Pressed state -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="BorderBrush" TargetName="border" Value="#FF3A2515"/>
                <Setter Property="BorderThickness" TargetName="border" Value="2.5"/>
            </Trigger>
            
            <!-- Disabled state: Keep border visible with DarkGoldenrod color and apply opacity -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" TargetName="grid" Value="0.5"/>
                <Setter Property="BorderBrush" TargetName="border" Value="Gold"/>
                <Setter Property="BorderThickness" TargetName="border" Value="2"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Style for standard Button -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Template" Value="{StaticResource SharedButtonTemplate}"/>
        <Style.Triggers>
            <!-- Custom pressed background for standard Button -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF5A3E2B" Offset="0"/>
                            <GradientStop Color="#FF3A2515" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Style for ToggleButton -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Template" Value="{StaticResource SharedButtonTemplate}"/>
    </Style>

</ResourceDictionary>