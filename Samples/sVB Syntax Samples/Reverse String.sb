
TextWindow.WriteLine("Enter any text, to reverse it:")
X = TextWindow.Read()
Y = "_"
ForEach Str In X
   Y = Str + Y
Next

TextWindow.WriteLine(Y.SubText(0, Y.Length - 1))

' A cleaner code using the concatination operator &
TextWindow.WriteLine("Enter any text, to reverse it:")
X = TextWindow.Read()
Y = ""
ForEach Chr In X
   Y = Chr & Y
Next

TextWindow.WriteLine(Y)